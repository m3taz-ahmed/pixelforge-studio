{
  "name": "Pixelforge Studio Demo",
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Pixelforge Studio",
      "visibility": "public",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "bash /workspaces/pixelforge-studio/.devcontainer/start-demo.sh"
}
